# L'Aura Cafe & Roastery — Environment Configuration
# Copy this file to .env.local for local development. Never commit .env.local to Git.

# ==============================================================================
# 1. Supabase Backend (Get from Supabase Dashboard > Project Settings > API)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-side only: Used by app/api/send-email to verify authoritative booking data and update delivery status
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ==============================================================================
# 2. Gmail SMTP Transactional Email Delivery (Server-side Only)
# ==============================================================================
# Note: Do NOT use your standard Google account password.
# 1. Enable 2-Step Verification in your Google Account.
# 2. Go to Google Account > Security > 2-Step Verification > App passwords.
# 3. Generate a 16-character App Password for "Mail".
GMAIL_USER=your-cafe-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
CAFE_OWNER_EMAIL=owner-email@gmail.com

